{
  "name": "@hyrious/fuzzy-match",
  "version": "0.1.1",
  "description": "Match string like Sublime Text",
  "author": "hyrious <hyrious@outlook.com>",
  "license": "MIT",
  "repository": "hyrious/fuzzy-match",
  "keywords": [
    "string",
    "match",
    "fuzzy",
    "search"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  },
  "scripts": {
    "test": "esbuild-dev test/baseline.ts",
    "test:trace": "esbuild-dev test/trace.ts",
    "build": "esbuild-dev scripts/build.ts"
  },
  "devDependencies": {
    "@hyrious/configs": "^0.1.6",
    "@hyrious/dts": "^0.3.8",
    "@hyrious/esbuild-dev": "^0.10.14",
    "@types/node": "^20.19.11",
    "esbuild": "^0.28.2",
    "nano-spawn": "^2.1.0",
    "pretty-bytes": "^7.1.3",
    "rollup": "^4.63.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
